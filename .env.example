# Naturesum Command Center — environment variables
# Copy this file to .env (or .env.local) and fill in values.
# .env / .env.local are git-ignored.

# Clerk publishable key (pk_test_... for development, pk_live_... for production).
# Get it from https://dashboard.clerk.com/last-active?path=api-keys
# When unset, the app runs WITHOUT an auth wall (useful for local dev before
# Clerk is configured).
VITE_CLERK_PUBLISHABLE_KEY=
